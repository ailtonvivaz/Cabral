# Swift Package Manager (Package.resolved IS committed if packages are added)
.swiftpm/
.build/

# Signing / notarization material: never commit
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.keychain-db
.env
.env.*

# Logs
*.log

# Local design scratch (icon prototypes live outside the repo)
/design/

